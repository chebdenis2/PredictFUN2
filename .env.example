# ================================================================================
# Predict.fun Market Maker Bot - Configuration
# ================================================================================
# Скопируйте этот файл в .env и заполните значения
# Copy this file to .env and fill in the values
# ================================================================================

# Приватный ключ кошелька (обязательно)
# Wallet private key (required)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Адрес Predict Account (smart wallet) - опционально
# Predict Account address (smart wallet) - optional
PREDICT_ACCOUNT=0xYOUR_PREDICT_ACCOUNT_HERE

# ================================================================================
# API AUTHENTICATION / АУТЕНТИФИКАЦИЯ API
# ================================================================================

# API Key (выдаётся индивидуально командой Predict.fun)
# API Key (issued individually by Predict.fun team)
API_KEY=YOUR_API_KEY_HERE

# ================================================================================
# MARKET FILTERS / ФИЛЬТРЫ РЫНКОВ
# ================================================================================

# Минимальная ликвидность в USD (по умолчанию: 0)
MIN_LIQUIDITY_USD=0

# Максимальная ликвидность в USD (по умолчанию: 15000)
# Низкая ликвидность = больше поинтов
MAX_LIQUIDITY_USD=15000

# Минимальная вероятность в % (по умолчанию: 40)
# "Неопределённые" рынки (40-60%) дают 2x множитель Predict Points
MIN_PROB_PERCENT=40

# Максимальная вероятность в % (по умолчанию: 60)
MAX_PROB_PERCENT=60

# ================================================================================
# POSITION LIMITS / ЛИМИТЫ ПОЗИЦИЙ
# ================================================================================

# Максимум USD на одну позицию (по умолчанию: 50)
# Бот не будет добирать позицию сверх этого лимита
MAX_POSITION_USD=50

# ================================================================================
# MARKET ORDER FALLBACK / РЫНОЧНЫЙ ВХОД ДЛЯ DELTA-NEUTRAL
# ================================================================================

# Разрешить рыночные ордера для фиксации delta-neutral (по умолчанию: true)
# Если одна лимитка сработала, а вторая нет — войти по рынку
ENABLE_MARKET_FALLBACK=true

# Максимальный убыток в % для рыночного входа (по умолчанию: 2.0)
# Если расчётный убыток больше — оставить лимитку
MAX_MARKET_LOSS_PERCENT=2.0

# ================================================================================
# MARKET ROTATION / РОТАЦИЯ РЫНКОВ
# ================================================================================

# Максимум минут на одном рынке (по умолчанию: 60, 0=без лимита)
# После этого времени — выход из рынка, поиск нового
# Ротация помогает получать больше Points за "новую ликвидность"
MAX_MARKET_HOLD_MINUTES=60

# Минимум минут до экспирации рынка (по умолчанию: 30)
# Не входить в рынки, которые закрываются скоро (высокая волатильность)
MIN_TIME_TO_EXPIRY_MINUTES=30

# ================================================================================
# POSITION RECOVERY / ВОССТАНОВЛЕНИЕ ПОЗИЦИЙ
# ================================================================================

# Восстанавливать позиции при перезапуске бота (по умолчанию: true)
# Бот проверит незахеджированные позиции и попробует закрыть delta-neutral
RECOVER_POSITIONS=true

# ================================================================================
# ORDER SETTINGS / НАСТРОЙКИ ОРДЕРОВ
# ================================================================================

# Целевой спред от mid-price (по умолчанию: 0.03 = 3%)
TARGET_SPREAD=0.03

# Размер каждого ордера в USD (по умолчанию: 25)
ORDER_SIZE_USD=25

# Время жизни ордера в минутах (по умолчанию: 60)
ORDER_EXPIRY_MINUTES=60

# ================================================================================
# TIMING / ТАЙМИНГИ
# ================================================================================

# Интервал ребалансировки в секундах (по умолчанию: 300 = 5 минут)
REBALANCE_INTERVAL_SEC=300

# Таймаут GraphQL запросов в секундах (по умолчанию: 10)
GRAPHQL_TIMEOUT_SEC=10

# ================================================================================
# LOGGING / ЛОГИРОВАНИЕ
# ================================================================================

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
