# === Predict.fun Market Maker Bot — Configuration ===

# Приватный ключ кошелька (NEVER commit real keys!)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Predict Account (smart wallet) адрес — берётся из predict.fun/account/settings
PREDICT_ACCOUNT=0xYOUR_PREDICT_ACCOUNT_ADDRESS

# API ключ Predict (запроси в Discord — discord.gg/predictdotfun)
PREDICT_API_KEY=

# === Стратегия ===
# Режим: PASSIVE_POINTS (далёкие ордера для фарма поинтов)
STRATEGY_MODE=PASSIVE_POINTS

# Отступ от mid-price (0.15 = 15%, 0.20 = 20%)
PASSIVE_SPREAD=0.15

# Размер одного ордера в USD
ORDER_SIZE_USD=20.0

# Максимальный размер позиции на один рынок в USD
MAX_POSITION_USD=100.0

# === Фильтрация рынков ===
# Мин/макс ликвидность рынка (USD)
MIN_LIQUIDITY_USD=1000.0
MAX_LIQUIDITY_USD=25000.0

# Диапазон вероятности для максимальных поинтов (2x multiplier)
MIN_PROBABILITY=0.45
MAX_PROBABILITY=0.55

# Макс. кол-во рынков для одновременной торговли
MAX_ACTIVE_MARKETS=3

# === Защита (Price Protection) ===
# Отменять ордер, если цена подошла слишком близко
CANCEL_WHEN_PRICE_CLOSE=true

# Порог близости цены (0.03 = 3%)
PRICE_PROXIMITY_THRESHOLD=0.03

# Интервал проверки цен (секунды)
PRICE_CHECK_INTERVAL_SEC=15

# === Ребалансировка ===
# Интервал поиска новых рынков (секунды)
REBALANCE_INTERVAL_SEC=300

# Не ставить новые ордера если позиция уже открыта
STOP_NEW_ORDERS_AFTER_FILL=true

# === Логирование ===
LOG_LEVEL=INFO
