# ================================================================================
# Predict.fun Market Maker Bot - Configuration
# ================================================================================
# Скопируйте этот файл в .env и заполните значения
# Copy this file to .env and fill in the values
# ================================================================================

# Приватный ключ кошелька (обязательно)
# Wallet private key (required)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Адрес Predict Account (smart wallet) - опционально
# Predict Account address (smart wallet) - optional
PREDICT_ACCOUNT=0xYOUR_PREDICT_ACCOUNT_HERE

# ================================================================================
# API AUTHENTICATION / АУТЕНТИФИКАЦИЯ API
# ================================================================================

# API Key (выдаётся индивидуально командой Predict.fun)
# API Key (issued individually by Predict.fun team)
API_KEY=YOUR_API_KEY_HERE

# ================================================================================
# MARKET FILTERS / ФИЛЬТРЫ РЫНКОВ
# ================================================================================

# Минимальная ликвидность в USD (по умолчанию: 0)
MIN_LIQUIDITY_USD=0

# Максимальная ликвидность в USD (по умолчанию: 15000)
# Низкая ликвидность = больше поинтов
MAX_LIQUIDITY_USD=15000

# ================================================================================
# ORDER SETTINGS / НАСТРОЙКИ ОРДЕРОВ
# ================================================================================

# Целевой спред от mid-price (по умолчанию: 0.03 = 3%)
TARGET_SPREAD=0.03

# Размер каждого ордера в USD (по умолчанию: 25)
ORDER_SIZE_USD=25

# ================================================================================
# TIMING / ТАЙМИНГИ
# ================================================================================

# Интервал ребалансировки в секундах (по умолчанию: 300 = 5 минут)
REBALANCE_INTERVAL_SEC=300

# Таймаут GraphQL запросов в секундах (по умолчанию: 10)
GRAPHQL_TIMEOUT_SEC=10

# ================================================================================
# LOGGING / ЛОГИРОВАНИЕ
# ================================================================================

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
