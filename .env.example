# ================================================================================
# Predict.fun Market Maker Bot - Configuration
# ================================================================================
# Скопируйте этот файл в .env и заполните значения
# Copy this file to .env and fill in the values
#
# ВАЖНО: Никогда не коммитьте .env с приватным ключом в git!
# IMPORTANT: Never commit .env with private key to git!
# ================================================================================

# Приватный ключ кошелька (обязательно)
# Wallet private key (required)
# Получить: Predict.fun → Account Settings → Export Privy Wallet
# Get from: Predict.fun → Account Settings → Export Privy Wallet
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# ================================================================================
# MARKET FILTERS / ФИЛЬТРЫ РЫНКОВ
# ================================================================================

# Минимальный Open Interest в USD (по умолчанию: 0)
MIN_OI_USD=0

# Максимальный Open Interest в USD (по умолчанию: 15000)
# Низкий OI = больше поинтов за ликвидность
MAX_OI_USD=15000

# ================================================================================
# ORDER SETTINGS / НАСТРОЙКИ ОРДЕРОВ
# ================================================================================

# Целевой спред от mid-price (по умолчанию: 0.03 = 3%)
# Target spread from mid-price (default: 0.03 = 3%)
TARGET_SPREAD=0.03

# Размер каждого ордера в USD (по умолчанию: 25)
# Size of each order in USD (default: 25)
ORDER_SIZE_USD=25

# Максимальная общая позиция в USD (по умолчанию: 500)
# Maximum total exposure in USD (default: 500)
MAX_TOTAL_EXPOSURE_USD=500

# ================================================================================
# TIMING / ТАЙМИНГИ
# ================================================================================

# Интервал ребалансировки в секундах (по умолчанию: 300 = 5 минут)
# Rebalance interval in seconds (default: 300 = 5 minutes)
REBALANCE_INTERVAL_SEC=300

# ================================================================================
# MARKET IDs (OPTIONAL) / ID РЫНКОВ (ОПЦИОНАЛЬНО)
# ================================================================================
# Оставьте пустым для автоматического выбора рынков
# Leave empty for automatic market selection
# Формат: через запятую / Format: comma-separated
# MARKET_IDS=market_id_1,market_id_2,market_id_3

# ================================================================================
# LOGGING / ЛОГИРОВАНИЕ
# ================================================================================

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
